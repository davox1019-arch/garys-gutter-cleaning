---
import type { FaqItem } from '../lib/schema';

export interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}</summary>
      <div class="faq-a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
