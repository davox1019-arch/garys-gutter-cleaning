---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../../site.config.mjs';

const who = site.legalName ? `${site.legalName}, trading as ${site.name}` : site.name;
---

<Layout
  enquireHref="/#enquire"
  title={`Privacy | ${site.name}`}
  description={`What ${site.name} collects when you send a gutter cleaning enquiry in Perth, why we collect it, and who it is shared with.`}
  crumbs={[{ name: 'Privacy', href: '/privacy/' }]}
>
  <main>
    <PageHero enquireHref="/#enquire">
      Privacy
      <Fragment slot="lead">What we collect when you send an enquiry, and what happens to it.</Fragment>
    </PageHero>
    <div class="wrap">

    <article class="prose" style="padding-bottom:3.5rem">
      <h2>Who we are</h2>
      <p>
        This site is operated by {who}{site.abn ? ` (ABN ${site.abn})` : ''}. We
        take enquiries for gutter cleaning in Perth, and Gary will come out
        and do the work.
      </p>

      <h2>What we collect, and when</h2>
      <ul>
        <li><strong>When you send an enquiry:</strong> your name, mobile number and suburb, the street address if you add it, any message, and the page you sent it from.</li>
        <li><strong>Automatically:</strong> your IP address, used only to limit abuse of the enquiry form.</li>
      </ul>

      <h2>What we use it for</h2>
      <p>
        The suburb and any street address are used to look at the property on satellite imagery and
        price the job. Your name and number are used to send you the price,
        arrange a time and carry out the work. We do not sell your details or use them for
        unrelated marketing.
      </p>

      <h2>Who it is shared with</h2>
      <ul>
        <li>Service providers that run the site: Cloudflare (hosting and database), Google (address suggestions as you type), and Resend (internal notification emails).</li>
      </ul>

      <h2>What is stored on your device</h2>
      <p>
        Your browser stores a reference to your quote so that the site can show
        it to you again if you come back. It holds no personal details and you
        can clear it by clearing this site's data in your browser.
      </p>

      <h2>Seeing or deleting your details</h2>
      <p>
        You can ask us what we hold about you, or ask us to delete it.
        {site.email
          ? <Fragment> Email <a href={`mailto:${site.email}`}>{site.email}</a>.</Fragment>
          : site.phone
            ? <Fragment> Send an enquiry from any page and say so in the message.</Fragment>
            : <Fragment> Reply to the text message we sent about your booking.</Fragment>}
      </p>
    </article>
    </div>
  </main>
</Layout>
