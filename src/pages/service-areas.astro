---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, priceBadge, fromPrice } from '../../site.config.mjs';
import { suburbPages, regions } from '../data/suburbPages';
---

<Layout
  title={`Gutter Cleaning Perth Suburbs | From $${fromPrice} | Trusted & Local`}
  description={`Gutter cleaning from $${fromPrice} ✓ Trusted & local ✓ Upfront pricing ✓ Every Perth suburb, from Joondalup to Rockingham and the Hills ✓ Free quote`}
  crumbs={[{ name: 'Service areas', href: '/service-areas/' }]}
>
  <main>
    <PageHero
      eyebrow="Every Perth suburb"
      badge={priceBadge}
      lead="Gutter cleaning in every suburb of the Perth metro area, from Two Rocks to Jarrahdale. Find yours below."
      sub={['Firm price by text', 'No site visit needed', 'Single & two storey']}
      secondary={{ href: '#suburbs', label: 'Find your suburb ↓' }}
    >
      Gutter Cleaning Service Areas <em>Perth</em>
    </PageHero>
    <div class="wrap">

    <div class="layout-aside">
      <div id="suburbs">
        {regions.map((g) => (
          <section style="margin-bottom:2.5rem">
            <h2>{g.title}</h2>
            <p class="muted narrow">{g.blurb}</p>
            <ul class="suburb-list">
              {suburbPages.filter((s) => s.region === g.key).map((s) => (
                <li>
                  <a href={`/gutter-cleaning-${s.slug}/`}>
                    Gutter cleaning {s.name}
                    <span>{s.postcode} · {s.council.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <section class="prose">
          <h2>Not on the list?</h2>
          <p>
            Send an enquiry with your suburb and you will get a price, or a
            straight answer that it is outside the area.
          </p>
          <p>
            Related: <a href="/gutter-cleaning-cost-perth/">gutter cleaning cost in Perth</a>,
            <a href="/downpipe-clearing-perth/">downpipe clearing</a> and
            <a href="/gutter-guard-perth/">gutter guard</a>.
          </p>
        </section>
      </div>

      <aside>
        <EnquiryForm />
      </aside>
    </div>
    </div>
  </main>
</Layout>
